# 复制成 .env 后再填（.env 不进 git）。都可以不填：demo 不需要任何密钥。

# 联系邮箱：写进外部请求的 User-Agent（arXiv、OpenAlex 的礼貌要求）。不填时 arXiv 的请求间隔加倍（6 秒一次）
CONTACT_EMAIL=

# OpenAlex：补被引数和参考文献（学习路径要用）。2026 年起必须带 key，免费，每天 $1 额度
OPENALEX_API_KEY=

# 代理：不填时沿用系统环境变量 HTTPS_PROXY / HTTP_PROXY；config.toml 的 no_proxy_hosts 里的域名始终直连
HTTPS_PROXY=

# 另一份配置，按键覆盖 pipeline/config.toml（demo/run.sh 会自动设成 demo/config.toml）
HS_CONFIG=
